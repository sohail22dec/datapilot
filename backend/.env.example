# ==============================================================================
# DataPilot Environment Configuration Template
# ==============================================================================

# ------------------------------------------------------------------------------
# Backend & AI Model Keys
# ------------------------------------------------------------------------------
# Supabase PostgreSQL connection string (direct connection with pooler or standard port 5432 / 6543)
DATABASE_URL=postgresql://postgres:[YOUR-PASSWORD]@db.[YOUR-PROJECT-REF].supabase.co:5432/postgres

# Groq API Key for high-speed multi-hop query routing & reasoning
GROQ_API_KEY=gsk_your_groq_api_key_here

# Google Gemini API Key for synthesis & chart generation
GEMINI_API_KEY=AIzaSy_your_gemini_api_key_here

# Application environment (development / staging / production)
ENVIRONMENT=development

# ------------------------------------------------------------------------------
# Frontend Configuration
# ------------------------------------------------------------------------------
# Backend API URL for client-side streaming and REST queries
NEXT_PUBLIC_BACKEND_URL=http://localhost:8000
